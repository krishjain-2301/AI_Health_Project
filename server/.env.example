# Copy this file to .env and add a key to turn on AI answers in the chat.
# Without a key the chat falls back to built-in keyword answers.
# Paste your Gemini key after the = sign (no quotes, no spaces), then restart the server.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini models to try, in order, separated by commas. A model that is
# busy or over quota is skipped for the next one. This is the default:
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3-flash-preview

# Alternative: use Claude instead by setting this and leaving GEMINI_API_KEY empty
# ANTHROPIC_API_KEY=
